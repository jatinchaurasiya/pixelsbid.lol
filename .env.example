# ==============================================================================
# PixelsBid.lol Production Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Neon Database (Serverless Postgres)
# ------------------------------------------------------------------------------
# In Neon Dashboard -> Connection details -> Copy pooled connection string (with ?sslmode=require)
DATABASE_URL=postgresql://neondb_owner:npg_SJCmnbM8hY4q@ep-noisy-sunset-ay4d2mrm.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# 2. Dodo Payments (Merchant of Record & Global Tax)
# ------------------------------------------------------------------------------
# Live Key (starts with live_...) or Test Key (starts with test_...)
DODO_PAYMENTS_API_KEY=live_your_dodo_api_key_here
# Environment: 'live_mode' for production or 'test_mode' for sandbox testing
DODO_PAYMENTS_ENVIRONMENT=live_mode
# Webhook Secret from Dodo Dashboard -> Webhooks (starts with whsec_...)
DODO_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ------------------------------------------------------------------------------
# 3. Application URLs & Better Auth
# ------------------------------------------------------------------------------
BETTER_AUTH_SECRET=85a3b4c7d9e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2c3d4e5f6a7b8
